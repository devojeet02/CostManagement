{
  "version": 2,
  "builds": [
    {
      "src": "cost-management/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/cost-management"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

